    "resumeDate": "2025-05-01"
}

### Delete User (Replace {USER_ID} with actual ID)
DELETE http://localhost:3000/auth/delete/{USER_ID}

### Get All Courses
GET http://localhost:3000/courses

### Add New Course
POST http://localhost:3000/courses
Content-Type: application/json

{
    "title": "React for Beginners",
    "description": "Learn the basics of React.js",
    "price": 49.99
}

### Update Course (Replace {COURSE_ID} with actual ID)
PUT http://localhost:3000/courses/{COURSE_ID}
Content-Type: application/json

{
    "title": "Advanced React",
    "description": "Master React.js",
