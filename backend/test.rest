    "username": "johndoe",
    "password": "12345678"
}

### Update User (Replace {USER_ID} with actual ID)
PUT http://localhost:3000/auth/update/{USER_ID}
Content-Type: application/json

{
    "fullName": "John Doe Updated",
    "email": "johndoe@example.com",
    "dob": "2000-05-15",
    "sex": "Male",
    "country": "USA",
    "state": "California",
    "city": "Los Angeles",
